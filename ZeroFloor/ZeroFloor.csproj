<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Сценарные JSON-данные — не код, копируются рядом с .exe, читаются ScenarioRepository
         по относительному пути от AppContext.BaseDirectory (см. App.xaml.cs). -->
    <None Include="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- Аудиоресурсы — читаются AudioResourceResolver по относительному пути от
         AppContext.BaseDirectory (Assets/Audio/<Категория>/<id>.<расширение>). -->
    <None Include="Assets\Audio\**\*.wav;Assets\Audio\**\*.mp3;Assets\Audio\**\*.wma" CopyToOutputDirectory="PreserveNewest" />

    <!-- Изображения персонажей — читаются AssetService по пути из Data/Characters/characters.json
         (имя файла = CharacterDefinition.ImagePath, относительно AppContext.BaseDirectory). -->
    <None Include="Assets\Characters\**\*.png;Assets\Characters\**\*.jpg;Assets\Characters\**\*.jpeg;Assets\Characters\**\*.webp" CopyToOutputDirectory="PreserveNewest" />

    <!-- Фоны сцен — читаются AssetService по пути из Data/Backgrounds/backgrounds.json. -->
    <None Include="Assets\Backgrounds\**\*.png;Assets\Backgrounds\**\*.jpg;Assets\Backgrounds\**\*.jpeg;Assets\Backgrounds\**\*.webp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Episodes\*.jpg;Assets\Episodes\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Minigames\atlas_section.png" />
    <Resource Include="Assets\Minigames\market_route_map.jpg;Assets\Minigames\gosha_card_table.jpg" />
  </ItemGroup>

</Project>
