<UserControl x:Class="ZeroFloor.Views.Controls.BirthFloorComparisonOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding ActiveBirthFloorComparison, Converter={StaticResource NullToVisibilityConverter}}">
    <UserControl.Resources>
        <Style x:Key="FloorButton" TargetType="Button" BasedOn="{StaticResource MgGhostButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Background" Value="#16212D"/>
            <Setter Property="BorderBrush" Value="#3C5265"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="7" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OpenStatus" TargetType="TextBlock" BasedOn="{StaticResource MgHint}">
            <Setter Property="Text" Value="✓  Доступен"/>
            <Setter Property="Foreground" Value="{StaticResource MgGreen}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="RouteStatus" TargetType="TextBlock" BasedOn="{StaticResource OpenStatus}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMiddleFloor}" Value="False">
                    <Setter Property="Text" Value="×  Закрыт"/>
                    <Setter Property="Foreground" Value="#FF8A7A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MapLabel" TargetType="TextBlock" BasedOn="{StaticResource MgLabel}">
            <Setter Property="Foreground" Value="#B9CAD4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#8306080D" DataContext="{Binding ActiveBirthFloorComparison}">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Style="{StaticResource MgCard}" Width="1130" Padding="34,28,34,26">
                <StackPanel>
                    <TextBlock Text="ГЛАВА 4 · КОРНИ" Style="{StaticResource MgEyebrow}"/>
                    <TextBlock Text="Один человек, два этажа" Style="{StaticResource MgTitle}"/>
                    <Border Style="{StaticResource MgDivider}" Margin="0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="256"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="234"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource MgInsetPanel}" VerticalAlignment="Top" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Учебный профиль" Style="{StaticResource MgLabel}" FontSize="19"
                                           Foreground="{StaticResource MgText}"/>
                                <TextBlock Text="Работа: техник" Style="{StaticResource MgBody}" Margin="0,14,0,0"/>
                                <TextBlock Text="Стаж: 7 лет" Style="{StaticResource MgBody}"/>
                                <Border Style="{StaticResource MgDivider}" Margin="0,16"/>
                                <TextBlock Text="Этаж рождения" Style="{StaticResource MgLabel}" FontSize="15"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="14-й" Command="{Binding SelectLowerFloorCommand}"
                                            AutomationProperties.Name="Этаж рождения, 14-й, Низы">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FloorButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMiddleFloor}" Value="False">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#221706"/>
                                                        <Setter Property="Background" Value="{StaticResource MgAccent}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="72-й" Command="{Binding SelectMiddleFloorCommand}"
                                            AutomationProperties.Name="Этаж рождения, 72-й, Средние этажи">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FloorButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMiddleFloor}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#221706"/>
                                                        <Setter Property="Background" Value="{StaticResource MgAccent}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <TextBlock Margin="0,13,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MgHint}">
                                            <Setter Property="Text" Value="Выбрано: Низы"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMiddleFloor}" Value="True">
                                                    <Setter Property="Text" Value="Выбрано: Средние этажи"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Canvas Grid.Column="1" Width="528" Height="354" ClipToBounds="True" IsHitTestVisible="False">
                            <Image Source="/ZeroFloor;component/Assets/Minigames/atlas_section.png"
                                   Width="382" Height="354" Canvas.Left="104" Stretch="Uniform"/>
                            <Path Data="M112,106 H472 M112,240 H472" Stroke="#516D82"
                                  StrokeThickness="1" StrokeDashArray="5 5"/>
                            <TextBlock Canvas.Left="17" Canvas.Top="53" Text="Корона" Style="{StaticResource MapLabel}"/>
                            <TextBlock Canvas.Left="17" Canvas.Top="151" Text="Средние этажи" Style="{StaticResource MapLabel}"/>
                            <TextBlock Canvas.Left="17" Canvas.Top="284" Text="Низы" Style="{StaticResource MapLabel}"/>
                            <Path Data="M262,327 V240" Stroke="{StaticResource MgGreen}" StrokeThickness="4"
                                  StrokeLineJoin="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="256" Canvas.Top="321" Width="12" Height="12"
                                     Stroke="{StaticResource MgGreen}" StrokeThickness="2" Fill="#152C2C"/>
                            <Path Data="M262,240 H294 V147 H365 M294,198 H338" StrokeThickness="4" StrokeLineJoin="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="#DD604F"/>
                                        <Setter Property="StrokeDashArray" Value="2 2.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMiddleFloor}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource MgGreen}"/>
                                                <Setter Property="StrokeDashArray" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Ellipse Canvas.Left="360" Canvas.Top="142" Width="10" Height="10" StrokeThickness="2" Fill="#14202A">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Stroke" Value="#DD604F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMiddleFloor}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource MgGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Border Canvas.Left="243" Canvas.Top="227" Padding="8,4" Background="#F1251A20"
                                    BorderBrush="#E66C56" BorderThickness="1" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMiddleFloor}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Шлюз закрыт" Style="{StaticResource MgHint}" Foreground="#FF9D8B"/>
                            </Border>
                        </Canvas>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Style="{StaticResource MgInsetPanel}" Padding="14,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Местный лифт" Style="{StaticResource MgLabel}" FontSize="16" Foreground="{StaticResource MgText}"/>
                                    <TextBlock Style="{StaticResource OpenStatus}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MgInsetPanel}" Padding="14,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Клиника · 85-й этаж" Style="{StaticResource MgLabel}" FontSize="16" Foreground="{StaticResource MgText}"/>
                                    <TextBlock Style="{StaticResource RouteStatus}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MgInsetPanel}" Padding="14,9">
                                <StackPanel>
                                    <TextBlock Text="Служебный лифт" Style="{StaticResource MgLabel}" FontSize="16" Foreground="{StaticResource MgText}"/>
                                    <TextBlock Style="{StaticResource RouteStatus}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource MgDivider}" Margin="0,16"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Вернуться к Виктору" Style="{StaticResource MgPrimaryButton}"
                                Command="{Binding ContinueCommand}" Margin="20,0,0,0"/>
                        <TextBlock FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MgHint}">
                                    <Setter Property="Text" Value="Измените этаж рождения, чтобы сравнить доступ.   ← →"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCompared}" Value="True">
                                            <Setter Property="Text" Value="Коэффициент стабилизации снижает рейтинг тех, кто родился в Низах."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
