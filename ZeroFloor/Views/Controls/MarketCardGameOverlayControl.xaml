<UserControl x:Class="ZeroFloor.Views.Controls.MarketCardGameOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding ActiveMarketCardGame, Converter={StaticResource NullToVisibilityConverter}}"
             Focusable="True" IsVisibleChanged="OnVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <Style x:Key="TableLabel" TargetType="TextBlock" BasedOn="{StaticResource MgTitle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#FFF1D2"/>
            <Setter Property="FontSize" Value="23"/>
        </Style>
        <Style x:Key="CardInk" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#273136"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRed}" Value="True">
                    <Setter Property="Foreground" Value="#8E322B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardHand" TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Width="110" Height="148" Margin="8,0">
                            <Border BorderBrush="#755B41" BorderThickness="2" CornerRadius="9" Background="#F0DBAD">
                                <Border.Effect>
                                    <DropShadowEffect Color="#170E08" BlurRadius="14" ShadowDepth="5" Opacity="0.8"/>
                                </Border.Effect>
                                <Grid>
                                    <TextBlock Text="{Binding Rank}" Style="{StaticResource CardInk}" FontSize="22"
                                               FontWeight="Bold" Margin="9,4" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding Suit}" Style="{StaticResource CardInk}" FontSize="51"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Rank}" Style="{StaticResource CardInk}" FontSize="22"
                                               FontWeight="Bold" Margin="9,4" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <Border BorderBrush="#E1B879" BorderThickness="3" CornerRadius="9" Background="#552E28"
                                    Visibility="{Binding IsFaceDown, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Border BorderBrush="#B68055" BorderThickness="1" CornerRadius="5" Margin="7"/>
                                    <Path Data="M52,18 L91,70 L52,124 L13,70 Z M52,34 L78,70 L52,108 L26,70 Z"
                                          Stroke="#CAA271" StrokeThickness="1.5"/>
                                    <TextBlock Text="◆" Foreground="#E1B879" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid DataContext="{Binding ActiveMarketCardGame}">
        <Grid.Background>
            <ImageBrush ImageSource="/ZeroFloor;component/Assets/Minigames/gosha_card_table.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        <Border Background="#4006070B" IsHitTestVisible="False"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Grid Width="1120" Height="625">
                <Grid.RowDefinitions>
                    <RowDefinition Height="73"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="84"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="268"/>
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="3" Background="#EB12181B" BorderBrush="#876846" BorderThickness="1" CornerRadius="8" Padding="21,10">
                    <StackPanel>
                        <TextBlock Text="ЯРМАРКА ТЕНЕЙ" Style="{StaticResource MgEyebrow}"/>
                        <TextBlock Text="Ставка у Гоши" Style="{StaticResource MgTitle}" FontSize="29"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GoshaLabel}" Style="{StaticResource TableLabel}" Margin="0,0,0,7"/>
                    <ItemsControl Style="{StaticResource CardHand}" ItemsSource="{Binding GoshaHand}" AutomationProperties.Name="Карты Гоши"/>
                    <ItemsControl Style="{StaticResource CardHand}" ItemsSource="{Binding MaxHand}" Margin="0,24,0,5" AutomationProperties.Name="Карты Макса"/>
                    <TextBlock Text="{Binding MaxLabel}" Style="{StaticResource TableLabel}"/>
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MgInsetPanel}"
                        BorderBrush="#AF7F51" Background="#EC161A1C"
                        VerticalAlignment="Center" Padding="19" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="СТАВКА" Style="{StaticResource MgEyebrow}"/>
                        <TextBlock Text="1 паёк" Style="{StaticResource MgTitle}" FontSize="27" Margin="0,4,0,10"/>
                        <TextBlock Text="Побеждает тот, кто ближе к 21 без перебора. Макс может взять ещё одну карту. Ничья в пользу Гоши."
                                   Foreground="#E5D7C0" Style="{StaticResource MgBody}"/>
                        <TextBlock Text="Валет, дама и король — 10. Туз — 1 или 11."
                                   Style="{StaticResource MgHint}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#F012181B" BorderBrush="#876846"
                        BorderThickness="1" CornerRadius="8" Padding="18,8" Margin="0,10,0,0">
                    <Grid>
                        <DockPanel LastChildFill="True" Visibility="{Binding CanPlay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Вскрыться" Command="{Binding StandCommand}" Style="{StaticResource MgGhostButton}" Margin="0,0,12,0"/>
                                <Button Content="Взять карту" Command="{Binding DrawCommand}" Style="{StaticResource MgPrimaryButton}"/>
                            </StackPanel>
                            <TextBlock Text="Гоша держит одну карту закрытой." Style="{StaticResource MgBody}"
                                       Foreground="#E5D7C0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </DockPanel>
                        <DockPanel LastChildFill="True" Visibility="{Binding IsResolved, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button DockPanel.Dock="Right" Content="Продолжить" Command="{Binding ContinueCommand}"
                                    Style="{StaticResource MgPrimaryButton}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Result}" Style="{StaticResource MgBody}" Foreground="#FFE0A7" FontSize="18"
                                       FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
