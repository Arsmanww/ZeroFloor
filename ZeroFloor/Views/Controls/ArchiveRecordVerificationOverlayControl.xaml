<UserControl x:Class="ZeroFloor.Views.Controls.ArchiveRecordVerificationOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding ActiveArchiveRecordVerification, Converter={StaticResource NullToVisibilityConverter}}"
             Focusable="True" IsVisibleChanged="OnVisibilityChanged"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Resources>
        <Style x:Key="SourceCard" TargetType="Border" BasedOn="{StaticResource MgInsetPanel}">
            <Setter Property="Background" Value="#182532"/>
            <Setter Property="BorderBrush" Value="#374A5B"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
        <Style x:Key="SourceBody" TargetType="TextBlock" BasedOn="{StaticResource MgBody}">
            <Setter Property="Foreground" Value="#DCE5EC"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="ArchiveAnswer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Foreground" Value="{StaticResource MgText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Face" Background="#18222D" BorderBrush="#425267"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <Ellipse x:Name="Marker" DockPanel.Dock="Left" Stroke="#8597A8"
                                         Width="12" Height="12" StrokeThickness="1.5" Margin="0,0,12,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#382B1C"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource MgAccent}"/>
                                <Setter TargetName="Marker" Property="Stroke" Value="{StaticResource MgAccent}"/>
                                <Setter TargetName="Marker" Property="Fill" Value="{StaticResource MgAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#9806080D" DataContext="{Binding ActiveArchiveRecordVerification}">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
            <Border Style="{StaticResource MgCard}" Width="1040" Padding="32,26,32,26">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Style="{StaticResource MgInsetPanel}"
                                Padding="14,9" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="{Binding ArchiveStatus}" Style="{StaticResource MgEyebrow}"/>
                                <TextBlock Style="{StaticResource MgHint}" Margin="0,4,0,0">
                                    <Run Text="Попыток до блокировки: "/><Run Text="{Binding AttemptsRemaining, Mode=OneWay}"
                                        Foreground="{StaticResource MgAccent}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="ГЛАВА 8 · ЛИЧНОЕ ДЕЛО ОРЛОВА" Style="{StaticResource MgEyebrow}"/>
                            <TextBlock Text="Протокол наследования" Style="{StaticResource MgTitle}"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource MgDivider}" Margin="0,16"/>

                    <Grid MinHeight="286">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.94*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="1.06*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ИСТОЧНИКИ" Style="{StaticResource MgLabel}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SourceCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource MgLabel}"
                                               FontSize="15" Foreground="{StaticResource MgCyan}"/>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource SourceBody}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SourceCard}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReferenceTitle}" Style="{StaticResource MgLabel}"
                                               FontSize="15" Foreground="{StaticResource MgCyan}"/>
                                    <TextBlock Text="{Binding Reference}" Style="{StaticResource SourceBody}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Stage}" Style="{StaticResource MgEyebrow}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Question}" Style="{StaticResource MgTitle}" FontSize="23" TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>
                                <ListBox ItemsSource="{Binding Answers}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource ArchiveAnswer}" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Варианты вывода">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <Border Style="{StaticResource SourceCard}" VerticalAlignment="Center"
                                    Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="✓  Приложение подтверждено" Style="{StaticResource MgTitle}"
                                               FontSize="23" TextWrapping="Wrap" Foreground="{StaticResource MgGreen}"/>
                                    <TextBlock Text="В архиве есть основание для передачи должности. Сохрани копию, чтобы предъявить её при необходимости."
                                               Style="{StaticResource SourceBody}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource MgDivider}" Margin="0,10,0,16"/>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                                IsDefault="True" Style="{StaticResource MgPrimaryButton}" Margin="20,0,0,0"/>
                        <Grid>
                            <TextBlock Text="Сверь источники и выбери вывод." VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MgHint}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Feedback}" Value=""/>
                                                    <Condition Binding="{Binding IsVerified}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Feedback}" Foreground="#FFAD92" Style="{StaticResource MgHint}"
                                       FontSize="15" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
