<UserControl x:Class="ZeroFloor.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusManager.IsFocusScope="True" Loaded="OnLoaded">
    <Grid x:Name="RootGrid" ClipToBounds="True" Background="#070E17">
        <TextBlock x:Name="FallbackTitle" Text="НУЛЕВОЙ&#10;ЭТАЖ"
                   Foreground="#E1E9EF" FontFamily="Segoe UI" FontSize="110" FontWeight="Bold"
                   Margin="96,72,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="96,382,0,0" Width="357">
            <Border Width="2" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#7896ACC1" Offset="0"/>
                        <GradientStop Color="#50627C92" Offset="0.5"/>
                        <GradientStop Color="#00627C92" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <StackPanel KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Button x:Name="NewGameButton" Content="НОВАЯ ИГРА" AutomationProperties.Name="Новая игра"
                        Style="{StaticResource MainMenuButtonStyle}" Command="{Binding NewGameCommand}"/>
                <Button Content="ПРОДОЛЖИТЬ" AutomationProperties.Name="Продолжить"
                        Style="{StaticResource MainMenuButtonStyle}" Command="{Binding ContinueGameCommand}"/>
                <Button Content="ЗАГРУЗИТЬ" AutomationProperties.Name="Загрузить"
                        Style="{StaticResource MainMenuButtonStyle}" Command="{Binding LoadGameCommand}"/>
                <Button Content="НАСТРОЙКИ" AutomationProperties.Name="Настройки"
                        Style="{StaticResource MainMenuButtonStyle}" Command="{Binding SettingsCommand}"/>
                <Button Content="ВЫХОД" AutomationProperties.Name="Выход"
                        Style="{StaticResource MainMenuButtonStyle}" Command="{Binding ExitCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
