<UserControl x:Class="ZeroFloor.Views.NovelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ZeroFloor.Views.Controls"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920"
             Focusable="True" IsTabStop="True"
             Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Grid ClipToBounds="True">

        <!--
            Сцена-мир: фон + персонажи вместе, одним целым — на этот контейнер действует
            "камера" (лёгкое приближение/отдаление, requirement 4-5), поэтому у него есть
            свой ScaleTransform, которым управляет ISceneTransitionService.ZoomAsync.
            HUD/диалог/журнал ниже вне этого контейнера — они не должны "плыть" вместе с камерой.
        -->
        <Grid x:Name="StageRoot" Background="{StaticResource StageBackgroundBrush}" RenderTransformOrigin="0.5,0.5">

            <!-- Два слоя фона для кроссфейда (requirement 8) + лёгкий параллакс на активном (requirement 9). -->
            <Border x:Name="BackgroundLayerA" Opacity="1"/>
            <Border x:Name="BackgroundLayerB" Opacity="0"/>

            <TextBlock x:Name="BackgroundCaption" Style="{StaticResource PlaceholderCaptionTextStyle}"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,0,0" Opacity="0.55"/>

            <!-- Лёгкие атмосферные эффекты окружения (requirement 12): пыль/дымка/мерцание. -->
            <Canvas x:Name="AmbientLayer" IsHitTestVisible="False" ClipToBounds="True"/>

            <controls:CharacterLayerControl x:Name="CharacterLayer"/>
        </Grid>

        <controls:ChoiceListControl/>
        <controls:DialogueBoxControl x:Name="DialogueBox"/>
        <controls:SuspicionMeterControl/>

        <!-- HUD: пауза, журнал, скрыть интерфейс -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,28,0"
                    Visibility="{Binding IsUiHidden, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ToggleButton Content="▶▶" Style="{StaticResource IconToggleButtonStyle}"
                          IsChecked="{Binding IsAutoAdvanceEnabled, Mode=TwoWay}"
                          ToolTip="Автоматическое продолжение" Margin="0,0,10,0"/>
            <Button Content="⏭" Style="{StaticResource IconButtonStyle}"
                    Command="{Binding SkipCommand}" ToolTip="Пропустить прочитанное" Margin="0,0,10,0"/>
            <ToggleButton Content="◎" Style="{StaticResource IconToggleButtonStyle}"
                          IsChecked="{Binding IsUiHidden, Mode=OneWay}" Command="{Binding ToggleUiCommand}"
                          ToolTip="Скрыть интерфейс" Margin="0,0,10,0"/>
            <ToggleButton Content="☰" Style="{StaticResource IconToggleButtonStyle}"
                          IsChecked="{Binding IsLogVisible, Mode=TwoWay}"
                          ToolTip="Журнал диалогов" Margin="0,0,10,0"/>
            <Button Content="⏸" Style="{StaticResource IconButtonStyle}"
                    Command="{Binding OpenPauseMenuCommand}" ToolTip="Пауза"/>
        </StackPanel>

        <!-- Подсказка-кнопка возврата интерфейса, когда он скрыт -->
        <Button Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                Command="{Binding RestoreUiCommand}"
                Visibility="{Binding IsUiHidden, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Интерфейс скрыт · нажмите, чтобы вернуть" Style="{StaticResource PlaceholderCaptionTextStyle}"
                       VerticalAlignment="Bottom" Margin="0,0,0,24"/>
        </Button>

        <controls:LogPanelControl/>
        <controls:PauseMenuControl/>
        <controls:WirePuzzleOverlayControl/>
        <controls:TimingBarOverlayControl/>
        <controls:StealthGridOverlayControl/>
        <controls:CodeAssemblyOverlayControl/>
        <controls:CableDiagnosticsOverlayControl/>
        <controls:RingLockOverlayControl/>
        <controls:LogScanOverlayControl/>
        <!-- Интерактивные эпизоды с фиксированной камерой. -->
        <controls:IllustratedEpisodeOverlayControl x:Name="IllustratedEpisodeOverlay"/>
        <controls:DossierAssemblyOverlayControl/>
        <controls:BirthFloorComparisonOverlayControl/>
        <controls:ArchiveRecordVerificationOverlayControl/>
        <controls:MarketWitnessRouteOverlayControl/>
        <controls:MarketCardGameOverlayControl/>

        <!-- Полноэкранное затемнение/осветление (requirement 7) — поверх всего, включая HUD. -->
        <Border x:Name="ScreenFadeOverlay" Background="Black" Opacity="1" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
